ACCESS_TOKEN=replace-with-a-long-random-token
# 用户系统（fastapi-users，账号密码登录，库文件 <DATA_DIR>/users.db）：
# 首次启动且用户库为空时播种的管理员，两者须同时配置；缺省则不播种
# （旧共享口令仍可用并映射为合成管理员）
INITIAL_ADMIN_EMAIL=admin@duet.com
INITIAL_ADMIN_PASSWORD=replace-with-a-24-char-random-password
# 会话 JWT 签名密钥；缺省显式回落为 ACCESS_TOKEN，需要独立轮换时再设置
USERS_JWT_SECRET=
# 用户库 SQLite 文件路径；缺省显式落在 <DATA_DIR>/users.db，需要改位置时再设置
USERS_DB_PATH=
# 多参考图模式：composed（多合一合成单张参考图）| direct（逐图直传）；缺省默认 direct，需多合一时显式改为 composed
MULTIREF_MODE=direct
DATA_DIR=/home/xy/duet-ad1-h3-max-r2v/data
PUBLIC_BASE_URL=https://replace-with-public-origin.example

PICSART_API_KEY=
PICSART_API_BASE=https://api.picsart.com
# 当 api.picsart.com 直连受 DNS 污染或网络限制时设代理；缺省直连
PICSART_PROXY=
# 豆包语音合成 2.0（逐句配音 TTS）：火山引擎控制台「API Key 管理」获取；未配置则配音节点报错
VOLC_VOICE_API_KEY=
ARK_API_KEY=
SEEDREAM_API_BASE=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628
SEEDREAM_TIMEOUT_S=300
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
FUSION_AGENT=deepseek
CODEX_TIMEOUT_S=1800
CODEX_CONCURRENCY=10
VOLC_MEDIAKIT_API_KEY=
MEDIAKIT_API_BASE=https://mediakit.cn-beijing.volces.com/api/v1
ENABLE_MEDIAKIT=true
MEDIAKIT_VIDEO_ERASE_MODE=pro

ASR_CLI=/home/xy/.local/share/duet-asr/whisper.cpp-1.9.2-src/build/bin/whisper-cli
ASR_MODEL=/home/xy/.local/share/duet-asr/ggml-small.bin
YAMNET_MODEL_PATH=/home/xy/duet-ad1-h3-max-r2v/models/yamnet.tflite

REQUEST_TIMEOUT_S=180
PROVIDER_POLL_INTERVAL_S=3
PROVIDER_POLL_TIMEOUT_S=1800
# 429 限流长退避的累计等待上限秒数（Retry-After 头优先，无头按 30/60/120/240/480s 指数退避）
PROVIDER_RATE_LIMIT_BUDGET_S=900
PICSART_TASK_HANG_LIMIT_S=21600
MAX_UPLOAD_MB=500

# 物品/人脸检测 provider 链路顺序：fal → wavespeed → sandbase，配置对应 key 即选中该家（按顺序取第一个已配置的），都未配置则物品遮盖节点不触发
# fal.ai SAM 3.1 video-rle 物品/人脸检测（链路第一位；SAM 3.1 + detection_threshold 可调，效果实测最好）。FAL_KEY 为 fal 平台统一凭证。
FAL_KEY=
# 检测置信度阈值，合法区间 (0,1]；文本 prompt 检不出时官方建议 0.2-0.3
FAL_SAM3_THRESHOLD=0.2
# 国内直连 fal.run 不通时设 http://127.0.0.1:7897；缺省直连
FAL_PROXY=
# WaveSpeed SAM3 video-rle（链路第二位后备；SAM 3 无阈值参数，词表稍长易整组零检出，见 data-verify/wavespeed-calib-20260919）
WAVESPEED_API_KEY=
# sandbase.ai SAM 3.1 video-rle（链路末位后备）；配置 SANDBASE_API_KEY 即用。国内直连 api.sandbase.ai 通畅，无 proxy 配置项
SANDBASE_API_KEY=
# 检测置信度阈值，合法区间 (0,1]；文本 prompt 检不出时官方建议 0.2-0.3
SANDBASE_SAM3_THRESHOLD=0.3
# 检测置信度阈值，合法区间 (0,1]；文本 prompt 检不出时官方建议 0.2-0.3
FAL_SAM3_THRESHOLD=0.2
# 物品灰块节点总开关：false 时不发起任何检测调用，走与降级等效的路径；缺省 true
OBJECT_MASK_ENABLED=true
# 灰块不透明度仅供测试（如 0.95/0.90）；生产 2026-10-03 起钉死 1.0 全不透明
# （用户拍板：半透明透出导致替换失败/源身份残留）。注意块下高斯模糊
# （OBJECT_MASK_BLOCK_BLUR）仅在 opacity<1.0 时才会执行，1.0 时代码短路不跑
# OBJECT_MASK_BLOCK_OPACITY=0.95
# 人物组灰块不透明度：默认 1.0 纯填充不模糊（2% 残影即身份泄漏实测）；物品组才用上面的 OPACITY
# OBJECT_MASK_PERSON_BLOCK_OPACITY=1.0

# 方舟音频理解（ark-audio-analysis 节点）：生产 key 用专用方舟 key；三项全部显式无默认，未配置则节点明确报错
ARK_AUDIO_API_KEY=
ARK_AUDIO_MODEL=doubao-seed-2-0-lite-260428
ARK_AUDIO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# 人声分离模型 ONNX 文件（vocal-separation 节点，安装脚本 scripts/install_vocal_separation_model.py）；未配置则节点明确报错
VOCAL_SEPARATION_MODEL_PATH=/home/xy/duet-ad1-h3-max-r2v/models/UVR-MDX-NET-Inst_HQ_3.onnx
# audio-separator 可执行文件（独立 venv，库硬依赖 torch 不进生产 venv，安装脚本同上落位）；未配置则节点明确报错
VOCAL_SEPARATION_CLI=/home/xy/duet-ad1-h3-max-r2v/.venv-separation/bin/audio-separator

# MiniMax 官方 Context IR 提示词优化（h3-context-ir 节点）：冻结前用 MiniMax-H3 官方
# 增强替换各段 h3_prompt.txt；显式 true 才启用（缺省关闭），启用时 key 必填。
# 计费 input $0.87/M、output $3.45/M token，失败不计费，典型单次 ~$0.02
MINIMAX_CONTEXT_IR_ENABLED=false
MINIMAX_CONTEXT_IR_API_KEY=
MINIMAX_CONTEXT_IR_API_BASE=https://api.minimaxi.com

# Picsart 备用 token：主 token 返回 402（预付 credits 用尽或订阅上限未开透支，
# 官方 error-codes 文档）时 submit 自动 failover；未配置 = 不启用。
# 任务账户隔离：task 由哪把 key 创建，poll/result/download 都用同一把
PICSART_API_KEY_BACKUP=
