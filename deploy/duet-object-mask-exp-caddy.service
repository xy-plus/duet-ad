[Unit]
Description=duet object-mask experiment HTTPS frontend on 3241
Wants=network-online.target
After=network-online.target duet-object-mask-exp.service
Requires=duet-object-mask-exp.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/duet/caddy run --config /home/xy/duet-ad1-h3-max-r2v-object-mask/deploy/caddy-3241.json
Restart=always
RestartSec=3s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=duet-object-mask-exp-caddy

[Install]
WantedBy=default.target
