ACCESS_TOKEN=replace-with-a-long-random-token
# 多参考图模式：composed（多合一合成单张参考图）| direct（逐图直传）；缺省默认 direct，需多合一时显式改为 composed
MULTIREF_MODE=direct
DATA_DIR=/home/xy/duet-ad1-h3-max-r2v/data
PUBLIC_BASE_URL=https://replace-with-public-origin.example

PICSART_API_KEY=
PICSART_API_BASE=https://api.picsart.com
# 当 api.picsart.com 直连受 DNS 污染或网络限制时设代理；缺省直连
PICSART_PROXY=
AUTODL_ART_TOKEN=
AUTODL_API_BASE=https://autodl.art
ARK_API_KEY=
SEEDREAM_API_BASE=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628
SEEDREAM_TIMEOUT_S=300
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
FUSION_AGENT=deepseek
CODEX_TIMEOUT_S=1800
CODEX_CONCURRENCY=10
VOLC_MEDIAKIT_API_KEY=
MEDIAKIT_API_BASE=https://mediakit.cn-beijing.volces.com/api/v1
ENABLE_MEDIAKIT=true
MEDIAKIT_VIDEO_ERASE_MODE=pro

ASR_CLI=/home/xy/.local/share/duet-asr/whisper.cpp-1.9.2-src/build/bin/whisper-cli
ASR_MODEL=/home/xy/.local/share/duet-asr/ggml-small.bin
YAMNET_MODEL_PATH=/home/xy/duet-ad1-h3-max-r2v/models/yamnet.tflite

REQUEST_TIMEOUT_S=180
PROVIDER_POLL_INTERVAL_S=3
PROVIDER_POLL_TIMEOUT_S=1800
PICSART_TASK_HANG_LIMIT_S=21600
MAX_UPLOAD_MB=500

# fal.ai SAM 3 video-rle 物品检测；配置 FAL_KEY 即启用，未配置则物品遮盖节点不触发。FAL_KEY 为 fal 平台统一凭证。
FAL_KEY=
# 国内直连 fal.run 不通时设 http://127.0.0.1:7897；缺省直连
FAL_PROXY=
# 检测置信度阈值，合法区间 (0,1]；文本 prompt 检不出时官方建议 0.2-0.3
FAL_SAM3_THRESHOLD=0.3
# 灰块不透明度仅供测试（如 0.95/0.90）；生产不显式设置时保持纯灰（1.0）
# OBJECT_MASK_BLOCK_OPACITY=0.95
