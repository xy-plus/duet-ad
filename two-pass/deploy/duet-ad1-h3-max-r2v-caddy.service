[Unit]
Description=duet-ad1 H3 Max R2V HTTPS frontend on 3301
Wants=network-online.target
After=network-online.target duet-ad1-h3-max-r2v.service
Requires=duet-ad1-h3-max-r2v.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/duet/caddy run --config /home/xy/duet-ad1-h3-max-r2v/deploy/caddy-3301.json
Restart=always
RestartSec=3s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=duet-ad1-h3-max-r2v-caddy

[Install]
WantedBy=default.target
