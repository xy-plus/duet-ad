[Unit]
Description=duet-ad1 H3 video studio
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/xy/duet-ad1
EnvironmentFile=%h/.config/duet-ad1/service.env
ExecStart=/home/xy/duet-ad1/run.sh
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
UMask=0077

# Codex creates its own bwrap user/mount/network namespaces.  Do not add
# systemd namespace directives here: on Ubuntu's AppArmor policy they move the
# service into unprivileged_userns and prevent the inner sandbox from starting.
NoNewPrivileges=true
LockPersonality=true
RestrictSUIDSGID=true
# bwrap needs AF_NETLINK to configure loopback inside its denied-network namespace.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

StandardOutput=journal
StandardError=journal
SyslogIdentifier=duet-ad1

[Install]
WantedBy=default.target
