{
  "name": "duet-ad1-web-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint:code": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "lint": "npm run typecheck && npm run lint:code && npm run lint:styles",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ant-design/icons": "6.1.0",
    "@ant-design/x": "2.9.0",
    "@tanstack/react-query": "5.102.3",
    "antd": "6.6.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "16.5.0",
    "stylelint": "17.14.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20.19"
  }
}
